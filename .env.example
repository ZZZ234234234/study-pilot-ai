# Copy to .env in the repository root. Never commit .env.
APP_ENV=development
# Blank uses development-only PGlite with `make dev`; production needs PostgreSQL.
DATABASE_URL=
DATA_DIR=./data
SESSION_SECRET=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_PROVIDER=demo
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434/v1
AI_TIMEOUT_SECONDS=90
CHUNK_SIZE=1400
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=6
MIN_SIMILARITY=0.18
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300
API_INTERNAL_URL=http://127.0.0.1:8000
# Optional real repository URL. Omitted: GitHub button opens the local source page.
NEXT_PUBLIC_GITHUB_URL=https://github.com/ZZZ234234234/study-pilot-ai
