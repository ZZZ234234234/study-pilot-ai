{
  "name": "studypilot-desktop",
  "productName": "StudyPilot AI",
  "version": "1.0.0",
  "private": true,
  "description": "本地优先的 PDF 阅读与 AI 学习助手",
  "author": "StudyPilot AI contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.studypilot.desktop",
    "asar": true,
    "files": [
      "main.cjs",
      "smoke.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "bundle",
        "to": "bundle"
      }
    ],
    "win": {
      "icon": "bundle/icon.png",
      "target": "nsis",
      "artifactName": "StudyPilot-AI-${version}-Windows-x64-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
